{
  // Cloudflare Worker: serves the static site + small payment API (/api/*)
  "name": "brazabrazil",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // Required by `wrangler preview` (preview builds for non-main branches)
  "previews": {},
  // Database for the admin panel (orders, finance, price changes) — created automatically on deploy
  "d1_databases": [{ "binding": "DB", "database_name": "brazabrazil-admin" }],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
